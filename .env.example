# Copy this file to .env and fill in your own values.
# .env is gitignored; it is loaded automatically by the CLI, MCP server, and web backend.
# Everything here is optional. Without an LLM configured, you can still use
# `cloud-diagram render` / `validate` / `explain` / `icons` with a hand-written
# or externally produced DiagramSpec JSON/YAML file — only `generate` and `plan`
# (natural-language input) require a planner.

# --- LLM planner (optional) ---------------------------------------------

# Base URL of an OpenAI-compatible /chat/completions API.
# Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   https://integrate.api.nvidia.com/v1   (NVIDIA NIM — free tier capped at 40 req/min, shared across all models)
#   http://localhost:11434/v1              (Ollama, local/offline)
CLOUD_DIAGRAM_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1

# Model name as expected by the endpoint above.
# For NVIDIA NIM: nvidia/llama-3.3-nemotron-super-49b-v1 is the recommended
# default here — NVIDIA's own post-trained model, strong strict-json_schema
# compliance, and much faster per-call than the 253B Nemotron Ultra, which
# matters more than Ultra's extra reasoning depth under the shared 40 RPM cap.
# Swap to nvidia/llama-3.3-nemotron-ultra-253b-v1 if you want maximum quality
# and can tolerate slower/queued responses.
CLOUD_DIAGRAM_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Name of the environment variable that actually holds your API key.
# The key VALUE itself must be set under that variable name below —
# this indirection means the key name never has to be "OPENAI_API_KEY"
# literally, and the key is never written into any config file.
CLOUD_DIAGRAM_LLM_API_KEY_NAME=NVIDIA_API_KEY

# The actual secret. Put your real key here in your own untracked .env file.
# Never commit a real key. Get one at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-own-key-here

# Request timeout in seconds (1-120).
CLOUD_DIAGRAM_PLANNER_TIMEOUT_SECONDS=30

# Max response tokens (256-32768).
CLOUD_DIAGRAM_PLANNER_MAX_TOKENS=4096

# --- Paths (optional, auto-discovered by default) -----------------------

# CLOUD_DIAGRAM_PROJECT_ROOT=/absolute/path/to/this/repo
# CLOUD_DIAGRAM_RULES_PATH=/absolute/path/to/config/rules/cloud-architecture.yaml
# CLOUD_DIAGRAM_REGISTRY_PATH=/absolute/path/to/assets/icons/registry.json

# --- Web UI backend (optional, only used by the FastAPI service) --------

# Host/port for `uvicorn cloud_diagram.web.app:app`.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Comma-separated origins allowed to call the backend from a browser.
WEB_CORS_ORIGINS=http://localhost:5173
